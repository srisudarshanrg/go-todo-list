create_table("tasks") {
    t.Column("id", "integer", {primary: true})
    t.Column("name", "string")
    t.Column("duration", "integer")
    t.Column("completed_status", "boolean")
    t.Column("user_id", "integer")
}

add_foreign_key("tasks", "user_id", {"users": ["id"]}, {
    "on_delete": "cascade",
    "on_update": "cascade",
})