{{define "base"}}
    <!doctype html>
    <html lang="en">
        <head>
            <meta charset="utf-8">
            <meta name="viewport" content="width=device-width, initial-scale=1">
            <title>{{block "title" .}} {{end}} | Todo</title>
            
            <!-- bootstrap css -->
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
        
            <!-- custom css -->
            <link rel="stylesheet" href="/static/css/common.css.css">
            {{block "css" .}} {{end}}

            <!-- favicon -->
            <link rel="icon" href="/static/img/favicon.png">
        </head>

        <body>
            {{if .Info}}
                <div class="alert alert-info alert-dismissible fade show" role="alert">
                    {{.Info}}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {{end}}

            {{if .Error}}
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    {{.Info}}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {{end}}

            <nav class="navbar navbar-expand-lg bg-warning navbar-light">
                <div class="container-fluid  justify-content-center">
                    <a class="navbar-brand" href="/"><img src="/static/img/favicon.png" width="35"> RaptorTodo</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse justify-content-center" id="navbarSupportedContent">
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <a class="nav-link" aria-current="page" href="/home"><i class="fa-solid fa-house"></i> Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link margin" href="/tasks"><i class="fa-solid fa-list-check"></i> Tasks</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link margin" href="/habit-tracker"><i class="fa-solid fa-chart-line"></i> Habit Tracker</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link margin" href="/notes"><i class="fa-regular fa-note-sticky"></i> Notes</a>
                            </li>
                        </ul>
                    </div>
                    <ul class="navbar-nav right-end">
                        <li class="nav-item">
                            <a href="/profile" class="nav-link"><i class="fa-solid fa-user"></i> Profile</a>
                        </li>
                        <li class="nav-item">
                            <a href="/logout" class="nav-link logout margin"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
                        </li>
                    </ul>
                </div>
            </nav>

            {{block "content" .}}

            {{end}}

            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
            <script src="https://kit.fontawesome.com/2ce79bf423.js" crossorigin="anonymous"></script>
        </body>
    </html>
{{end}}